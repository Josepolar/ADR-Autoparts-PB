# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/adr_autoparts"

# ============================================
# NEXT_AUTH - Authentication
# ============================================
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Email provider (nodemailer)
EMAIL_FROM="noreply@adr-autoparts.com"
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="your-email@gmail.com"
EMAIL_SMTP_PASSWORD="your-app-specific-password"

# ============================================
# STRIPE - Payment Processing
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# UPLOADTHING - File Upload
# ============================================
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-app-id"

# ============================================
# AWS S3 - File Storage
# ============================================
AWS_REGION="us-east-1"
AWS_S3_BUCKET="adr-autoparts-files"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_SIGNED_URL_EXPIRATION=3600

# ============================================
# PHILIPPINE PAYMENT GATEWAYS (Phase 3)
# ============================================
# GCASH/Maya Test Credentials (to be populated)
GCASH_API_KEY="test-gcash-key"
GCASH_SECRET="test-gcash-secret"
GCASH_MERCHANT_ID="test-merchant"

MAYA_API_KEY="test-maya-key"
MAYA_SECRET="test-maya-secret"
MAYA_MERCHANT_ID="test-merchant"

# ============================================
# APPLICATION
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="ADR Autoparts"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ============================================
# LOGGING & DEBUG
# ============================================
LOG_LEVEL="debug"
