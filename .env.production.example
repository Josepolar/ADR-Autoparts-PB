# ============================================
# PRODUCTION ENVIRONMENT VARIABLES FOR VERCEL
# ============================================
# Set these in Vercel Dashboard → Project Settings → Environment Variables

# DATABASE - Supabase PostgreSQL
# Get from: https://supabase.com/dashboard → Your Project → Settings → Database → Connection String (NodeJS)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres"

# NEXTAUTH - Authentication
NEXTAUTH_SECRET="[GENERATE: openssl rand -base64 32]"
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"

# STRIPE - Payment Processing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AWS S3 - File Storage
AWS_REGION="us-east-1"
AWS_S3_BUCKET="adr-autoparts-prod"
AWS_ACCESS_KEY_ID="[Your AWS Access Key]"
AWS_SECRET_ACCESS_KEY="[Your AWS Secret Key]"

# UPLOADTHING - File Upload (optional)
UPLOADTHING_SECRET="[Your UploadThing Secret]"
UPLOADTHING_APP_ID="[Your App ID]"

# EMAIL - Nodemailer
EMAIL_FROM="noreply@adr-autoparts.com"
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="[Your Gmail]"
EMAIL_SMTP_PASSWORD="[Your App Password]"

# PHILIPPINE GATEWAYS (Phase 3)
GCASH_API_KEY="[Live GCash Key]"
GCASH_SECRET="[Live GCash Secret]"
GCASH_MERCHANT_ID="[Your Merchant ID]"
